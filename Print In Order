import threading

class Foo:
    def __init__(self):
        # Initialize flags to coordinate the execution order
        self.first_done = threading.Event()
        self.second_done = threading.Event()

    def first(self, printFirst):
        # printFirst() outputs "first". Do not change or remove this line.
        printFirst()
        # Notify the waiting threads that first() is done
        self.first_done.set()

    def second(self, printSecond):
        # Wait until first() has completed execution
        self.first_done.wait()
        # printSecond() outputs "second". Do not change or remove this line.
        printSecond()
        # Notify the waiting threads that second() is done
        self.second_done.set()

    def third(self, printThird):
        # Wait until second() has completed execution
        self.second_done.wait()
        # printThird() outputs "third". Do not change or remove this line.
        printThird()
