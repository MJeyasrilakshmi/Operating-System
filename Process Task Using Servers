import java.util.PriorityQueue;

class Solution {
    public int[] assignTasks(int[] servers, int[] tasks) {
        int m = tasks.length;
        int[] ans = new int[m];
        PriorityQueue<int[]> freeServers = new PriorityQueue<>((a, b) -> {
            if (a[0] != b[0]) {
                return Integer.compare(a[0], b[0]);
            }
            return Integer.compare(a[1], b[1]);
        });
        PriorityQueue<int[]> busyServers = new PriorityQueue<>((a, b) -> 
            Integer.compare(a[0], b[0])
        );
        for (int i = 0; i < servers.length; i++) {
            freeServers.offer(new int[]{servers[i], i});
        }
        
        int time = 0;
        for (int j = 0; j < m; j++) {
            time = Math.max(time, j);
            if (freeServers.isEmpty()) {
                time = Math.max(time, busyServers.peek()[0]);
            }
            while (!busyServers.isEmpty() && busyServers.peek()[0] <= time) {
                int[] freed = busyServers.poll();
                freeServers.offer(new int[]{freed[1], freed[2]});
            }
            int[] bestServer = freeServers.poll();
            ans[j] = bestServer[1]; 
            busyServers.offer(new int[]{time + tasks[j], bestServer[0], bestServer[1]});
        }
        
        return ans;
    }
}
